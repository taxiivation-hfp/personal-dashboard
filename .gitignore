/node_modules
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts

# local libSQL database (Phase 1 lives here; never commit personal data)
/data

# secrets
.env
.env.local
.env*.local
# Live Turso credentials for scripts/seed-roadmap.mjs. Deliberately NOT .env.local, so
# `next dev` can never read them and write to production by accident — which means it also
# does not match the patterns above and has to be named here.
.env.seed

# local tool state, not project config
.claude/settings.local.json
.impeccable/

.DS_Store

# Scratch files from contrast/geometry checks. Never part of the app.
.tmp-*

# Production builds go here so they never collide with the dev server.
.next-build/

# Agent scratch files.
scratch-*
