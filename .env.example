# Copy to .env.local and fill in.

# Required for the Claude coach (Anthropic API key, starts with sk-ant-...).
# Without it the app still runs; the coach replies with a setup hint.
ANTHROPIC_API_KEY=

# Coach model — one-line swap. Sonnet 4.6 (Haiku 4.5 was tested but missed/hallucinated tool
# calls, so it's reserved for cheap background jobs — digest, journal themes, profile rewrite).
COACH_MODEL=claude-sonnet-4-6
# Reasoning effort — only applies to 4.6+/Fable models (Sonnet 4.6, Opus). Ignored on Haiku 4.5.
COACH_EFFORT=medium

# --- Google Calendar (Phase 2) ---
# In Google Cloud Console: create an OAuth 2.0 Client ID of type "Web application",
# keep the OAuth app in "Testing" mode and add yourself as a test user (skips verification).
#
# Register an Authorized redirect URI for EVERY origin you press Connect from — Google
# matches them byte-for-byte:
#     http://localhost:3000/api/google/callback
#     https://<your-deployment>/api/google/callback
#
# THERE IS NO GOOGLE_REDIRECT_URI TO SET, deliberately. The app derives the callback from
# the incoming request, so consent always returns to the origin you started it on. Setting
# one variable could only ever name ONE host, and an unset-or-stale value is what sent the
# live site's Connect button to localhost on 2026-08-14. Set it only to override a proxy
# the app cannot read, and only to a URL on that same origin — a value naming a different
# host is ignored rather than obeyed. See callbackUrl() in src/lib/google.ts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local libSQL file. Swap to a Turso URL (libsql://...) + TURSO_AUTH_TOKEN to deploy.
# NOTE: the app REFUSES TO BOOT in production with a file: URL — a container filesystem
# is ephemeral and every write would be silently destroyed on the next restart.
DATABASE_URL=file:./data/dashboard.db
# TURSO_AUTH_TOKEN=

# --- Phase 3: health push from the phone ---
# Shared secret for POST /api/health. A phone can't hold a browser session cookie, so
# the iOS Shortcut authenticates with this in an `x-app-secret` header instead.
# Generate a long random value; never reuse the passcode.
HEALTH_PUSH_SECRET=

# Optional single-user passcode gate. Leave blank for no gate (local dev).
APP_PASSCODE=
